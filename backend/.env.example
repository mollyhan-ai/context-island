# 原型测试默认使用阿里云百炼北京地域的 Qwen3.8-Flash。
# 不要把真实密钥写入这个示例文件或提交到仓库。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_RESPONSE_FORMAT=json_schema
# 词卡属于短结构化任务，关闭思考以降低等待时间。
LLM_EXTRA_BODY_JSON='{"enable_thinking":false}'
# 单张卡片输出短，2048 足够并能避免异常长输出。
LLM_MAX_TOKENS=2048

# Optional runtime settings.
LEXICON_DB_PATH=data/lexicon.db
# 单次模型请求最长等待时间。
LLM_TIMEOUT_SECONDS=60
# JSON Schema 约束输出结构；本地语义校验失败时最多修正三次。
LLM_MAX_ATTEMPTS=3
HOST=127.0.0.1
PORT=8767
ALLOWED_ORIGINS=http://127.0.0.1:8766,http://localhost:8766

# 公开部署时建议启用；0 表示不限制。本地开发可保持 0。
GENERATION_RATE_LIMIT_REQUESTS=0
GENERATION_GLOBAL_LIMIT_REQUESTS=0
GENERATION_RATE_LIMIT_WINDOW_SECONDS=3600
TRUST_PROXY=0
